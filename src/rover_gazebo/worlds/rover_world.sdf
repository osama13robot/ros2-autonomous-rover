<?xml version="1.0" ?>
<!--
  rover_world: 14 m x 10 m indoor environment for the rover.
  * rooms connected by doorways (exploration / SLAM)
  * pillars, crates, furniture with thin legs (lidar-only would struggle)
  * LOW obstacles (8-10 cm) under the lidar plane that only the depth camera detects
  Robot spawns at the origin facing +x.
-->
<sdf version="1.9">
  <world name="rover_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-4 -9 9 0 0.75 1.0</pose>
      </camera>
    </gui>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.55 0.55 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="outer_n">
        <pose>0.000 5.000 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>14.150 0.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>14.150 0.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="outer_s">
        <pose>0.000 -5.000 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>14.150 0.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>14.150 0.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="outer_w">
        <pose>-7.000 0.000 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.150 10.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.150 10.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="outer_e">
        <pose>7.000 0.000 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.150 10.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.150 10.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="w1_s">
        <pose>-2.000 -2.750 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.150 4.650 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.150 4.650 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="w1_n">
        <pose>-2.000 3.000 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.150 4.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.150 4.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="w2_w">
        <pose>-5.800 1.500 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.550 0.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.550 0.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="w2_e">
        <pose>-2.700 1.500 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.550 0.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.550 0.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="w3">
        <pose>3.000 2.600 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.150 4.950 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.150 4.950 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="w4">
        <pose>5.650 -1.500 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>2.850 0.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.850 0.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
      <link name="w5_short">
        <pose>-1.400 -2.500 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.350 0.150 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.350 0.150 1.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- furniture & obstacles -->
    <model name="shelf_1">
      <static>true</static>
      <pose>-6.4 3.2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 1.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 1.6 1.2</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="sofa">
      <static>true</static>
      <pose>-4.2 3.9 0.225 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.8 0.8 0.45</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.8 0.8 0.45</size></box></geometry>
          <material><ambient>0.2 0.3 0.6 1</ambient><diffuse>0.2 0.3 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="dining_table">
      <static>true</static>
      <pose>-4.8 -2.8 0 0 0 0</pose>
      <link name="link">
        <collision name="leg0_c"><pose>0.5499999999999999 0.35000000000000003 0.345 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry></collision>
        <visual name="leg0_v"><pose>0.5499999999999999 0.35000000000000003 0.345 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg1_c"><pose>0.5499999999999999 -0.35000000000000003 0.345 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry></collision>
        <visual name="leg1_v"><pose>0.5499999999999999 -0.35000000000000003 0.345 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg2_c"><pose>-0.5499999999999999 0.35000000000000003 0.345 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry></collision>
        <visual name="leg2_v"><pose>-0.5499999999999999 0.35000000000000003 0.345 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg3_c"><pose>-0.5499999999999999 -0.35000000000000003 0.345 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry></collision>
        <visual name="leg3_v"><pose>-0.5499999999999999 -0.35000000000000003 0.345 0 0 0</pose><geometry><box><size>0.04 0.04 0.69</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="top_c"><pose>0 0 0.705 0 0 0</pose><geometry><box><size>1.2 0.8 0.03</size></box></geometry></collision>
        <visual name="top_v"><pose>0 0 0.705 0 0 0</pose><geometry><box><size>1.2 0.8 0.03</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cabinet">
      <static>true</static>
      <pose>-6.5 -4.3 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.6 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.6 0.9</size></box></geometry>
          <material><ambient>0.9 0.9 0.95 1</ambient><diffuse>0.9 0.9 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>0.8 2.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>1.0 -3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.18</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>5.2 3.4 0.3 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.75 0.55 0.25 1</ambient><diffuse>0.75 0.55 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_2">
      <static>true</static>
      <pose>4.4 1.6 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.8 0.5</size></box></geometry>
          <material><ambient>0.75 0.55 0.25 1</ambient><diffuse>0.75 0.55 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_3">
      <static>true</static>
      <pose>6.2 0.6 0.2 0 0 0.7</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material><ambient>0.75 0.55 0.25 1</ambient><diffuse>0.75 0.55 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="work_bench">
      <static>true</static>
      <pose>5.4 -3.3 0 0 0 0</pose>
      <link name="link">
        <collision name="leg0_c"><pose>0.6499999999999999 0.3 0.385 0 0 0</pose><geometry><box><size>0.04 0.04 0.77</size></box></geometry></collision>
        <visual name="leg0_v"><pose>0.6499999999999999 0.3 0.385 0 0 0</pose><geometry><box><size>0.04 0.04 0.77</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg1_c"><pose>0.6499999999999999 -0.3 0.385 0 0 0</pose><geometry><box><size>0.04 0.04 0.77</size></box></geometry></collision>
        <visual name="leg1_v"><pose>0.6499999999999999 -0.3 0.385 0 0 0</pose><geometry><box><size>0.04 0.04 0.77</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg2_c"><pose>-0.6499999999999999 0.3 0.385 0 0 0</pose><geometry><box><size>0.04 0.04 0.77</size></box></geometry></collision>
        <visual name="leg2_v"><pose>-0.6499999999999999 0.3 0.385 0 0 0</pose><geometry><box><size>0.04 0.04 0.77</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="leg3_c"><pose>-0.6499999999999999 -0.3 0.385 0 0 0</pose><geometry><box><size>0.04 0.04 0.77</size></box></geometry></collision>
        <visual name="leg3_v"><pose>-0.6499999999999999 -0.3 0.385 0 0 0</pose><geometry><box><size>0.04 0.04 0.77</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="top_c"><pose>0 0 0.785 0 0 0</pose><geometry><box><size>1.4 0.7 0.03</size></box></geometry></collision>
        <visual name="top_v"><pose>0 0 0.785 0 0 0</pose><geometry><box><size>1.4 0.7 0.03</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="barrel">
      <static>true</static>
      <pose>3.6 -3.9 0.45 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.28</radius><length>0.9</length></cylinder></geometry>
          <material><ambient>0.1 0.4 0.15 1</ambient><diffuse>0.1 0.4 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk">
      <static>true</static>
      <pose>1.6 4.3 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.4 0.7 0.75</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.4 0.7 0.75</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.5 0.35 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <!-- LOW obstacles (8-10 cm): BELOW the lidar plane, only the depth camera sees them -->
    <model name="low_brick_1">
      <static>true</static>
      <pose>-0.6 1.4 0.04 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.12 0.08</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.12 0.08</size></box></geometry>
          <material><ambient>0.8 0.15 0.1 1</ambient><diffuse>0.8 0.15 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="low_brick_2">
      <static>true</static>
      <pose>2.0 -1.2 0.05 0 0 -0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.35 0.15 0.1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.35 0.15 0.1</size></box></geometry>
          <material><ambient>0.8 0.15 0.1 1</ambient><diffuse>0.8 0.15 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="low_brick_3">
      <static>true</static>
      <pose>-4.0 0.3 0.04 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.12 0.08</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.12 0.08</size></box></geometry>
          <material><ambient>0.8 0.15 0.1 1</ambient><diffuse>0.8 0.15 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="low_step">
      <static>true</static>
      <pose>5.0 -0.6 0.045 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 0.6 0.09</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 0.6 0.09</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="low_bin">
      <static>true</static>
      <pose>-0.5 -3.8 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>0.1 0.5 0.9 1</ambient><diffuse>0.1 0.5 0.9 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
