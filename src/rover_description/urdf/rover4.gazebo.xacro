<?xml version="1.0"?>
<!--
  Rover4 Gazebo (Harmonic) plugins and sensors. Topics match the 2WD rover, so the same
  bridge (rover_gazebo/config/gz_bridge.yaml) and the same autonomy stack are reused.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <!-- Ackermann steering: /cmd_vel (v, yaw rate) -> steering angles + speed of all 4 wheels.
         TF odom->base_footprint comes from the EKF, not from here. -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>${2*kingpin_y}</kingpin_width>
      <steering_limit>${steer_limit}</steering_limit>
      <wheel_base>${L}</wheel_base>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${R}</wheel_radius>
      <min_velocity>-0.6</min_velocity>
      <max_velocity>0.6</max_velocity>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel/odometry</odom_topic>
      <tf_topic>/wheel/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- wheel encoders + steering angles -> /joint_states -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ================= RPLIDAR S2M1 ================= -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>/scan</topic>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>${lidar['rate']}</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar['samples']}</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2*pi/lidar['samples']}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar['min_range']}</min>
          <max>${lidar['max_range']}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.015</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================= RealSense D435i: RGB-D ================= -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <topic>/camera</topic>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>${cam['rate']}</update_rate>
      <camera name="d435i">
        <horizontal_fov>${cam['hfov']}</horizontal_fov>
        <image>
          <width>${cam['image_width']}</width>
          <height>${cam['image_height']}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>${cam['min_depth']}</near>
            <far>${cam['max_depth']}</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ================= RealSense D435i: IMU (BMI055) ================= -->
  <xacro:macro name="imu_noise" params="stddev bias">
    <noise type="gaussian">
      <mean>0.0</mean>
      <stddev>${stddev}</stddev>
      <bias_mean>${bias}</bias_mean>
      <bias_stddev>${bias/10}</bias_stddev>
    </noise>
  </xacro:macro>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu</topic>
      <always_on>true</always_on>
      <update_rate>${cam['imu_rate']}</update_rate>
      <imu>
        <angular_velocity>
          <x><xacro:imu_noise stddev="1e-3" bias="5e-5"/></x>
          <y><xacro:imu_noise stddev="1e-3" bias="5e-5"/></y>
          <z><xacro:imu_noise stddev="1e-3" bias="5e-5"/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><xacro:imu_noise stddev="2e-2" bias="1e-3"/></x>
          <y><xacro:imu_noise stddev="2e-2" bias="1e-3"/></y>
          <z><xacro:imu_noise stddev="2e-2" bias="1e-3"/></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
