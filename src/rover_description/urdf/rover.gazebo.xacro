<?xml version="1.0"?>
<!--
  Gazebo (gz-sim / Harmonic) plugins and sensors.
  Gazebo topics are bridged to ROS 2 by rover_gazebo/config/gz_bridge.yaml.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <!-- Differential drive: consumes cmd_vel, publishes wheel odometry.
         TF odom->base_footprint is NOT taken from here: the EKF (wheel odom + IMU) publishes it. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_radius>${R}</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-1.5</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <min_angular_velocity>-3.0</min_angular_velocity>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel/odometry</odom_topic>
      <tf_topic>/wheel/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>

    <!-- Wheel encoders -> /joint_states -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ================= 2D lidar ================= -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>/scan</topic>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>${lidar['rate']}</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar['samples']}</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle>
            <max_angle>${pi - 2*pi/lidar['samples']}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar['min_range']}</min>
          <max>${lidar['max_range']}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================= RGB-D camera ================= -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <topic>/camera</topic>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>${cam['rate']}</update_rate>
      <camera name="rgbd">
        <horizontal_fov>${cam['hfov']}</horizontal_fov>
        <image>
          <width>${cam['image_width']}</width>
          <height>${cam['image_height']}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>${cam['min_depth']}</near>
            <far>${cam['max_depth']}</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ================= IMU ================= -->
  <xacro:macro name="imu_noise" params="stddev bias">
    <noise type="gaussian">
      <mean>0.0</mean>
      <stddev>${stddev}</stddev>
      <bias_mean>${bias}</bias_mean>
      <bias_stddev>${bias/10}</bias_stddev>
    </noise>
  </xacro:macro>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu</topic>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <angular_velocity>
          <x><xacro:imu_noise stddev="2e-4" bias="1e-5"/></x>
          <y><xacro:imu_noise stddev="2e-4" bias="1e-5"/></y>
          <z><xacro:imu_noise stddev="2e-4" bias="1e-5"/></z>
        </angular_velocity>
        <linear_acceleration>
          <x><xacro:imu_noise stddev="1.7e-2" bias="1e-3"/></x>
          <y><xacro:imu_noise stddev="1.7e-2" bias="1e-3"/></y>
          <z><xacro:imu_noise stddev="1.7e-2" bias="1e-3"/></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

</robot>
